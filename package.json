{
  "name": "tend-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "vite build",
    "build:server": "tsc -p server/tsconfig.build.json",
    "build:all": "npm run build && npm run build:server",
    "start": "node server/dist/index.js",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "supertest": "^7.3.0",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.2"
  }
}
