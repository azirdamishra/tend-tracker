# Runs Tend (frontend + storage API, one process/one port) on boot, and
# restarts it automatically if it ever crashes.
#
# Install on the Pi:
#   sudo cp systemd/tend.service /etc/systemd/system/tend.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tend
#
# Check on it:
#   systemctl status tend
#   journalctl -u tend -f
#
# Edit User, WorkingDirectory and DATA_FILE below to match your Pi setup
# before installing.

[Unit]
Description=Tend budget tracker
# Wait for a real IP, not just the network interface existing — on a cold
# boot after a power outage, Wi-Fi association + DHCP can take longer than
# network.target waits for, which previously left Tend trying to bind/serve
# before the network was actually usable.
After=network-online.target
Wants=network-online.target
# Tolerate a rough boot (slow SD card, data dir not mounted yet) without
# giving up instantly — but still give up eventually rather than retrying
# forever if the cause turns out to be permanent (bad config, corrupt
# file): up to 10 restarts within a 10-minute window.
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/tend-tracker
Environment=PORT=3001
Environment=DATA_FILE=/home/pi/tend-data/tend-store.json
# Uncomment and set your own value to require a shared passphrase before
# Tend loads (protects against anyone else on your WiFi opening it).
# Don't commit your real passphrase to git.
# Environment=TEND_PASSPHRASE=
ExecStart=/usr/bin/node server/dist/index.js
# always (not just on-failure) + the StartLimit* above: survive more than
# systemd's default 5-tries-in-10s burst limit, which otherwise leaves the
# service permanently stopped if it fails a few times right after a rough
# boot (e.g. data dir not mounted yet).
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
